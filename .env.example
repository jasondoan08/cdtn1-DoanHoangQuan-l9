PYTHONPATH=.
DATA_PATH=data/
# ==========================================
# CẤU HÌNH MÔI TRƯỜNG - MEKONG MOBILE SMART CRM
# ==========================================

# Môi trường chạy ứng dụng (development / production)
APP_ENV=development

# Cổng kết nối dịch vụ API FastAPI
PORT=8000

# Mức độ ghi log hệ thống (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# Thư mục lưu trữ mô hình và artifact
MODEL_PATH=src/models/artifacts/